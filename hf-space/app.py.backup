LOG_BUFFER: deque = deque(maxlen=3000)


def log(msg: str):
    print(msg, flush=True)
    LOG_BUFFER.append({"t": time.time(), "msg": msg})


def log_section(title: str):
    log("")
    log("=" * 70)
    log(f"  {title}")
    log("=" * 70)


