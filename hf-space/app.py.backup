# GRADIO
# ============================================================

def strip_markdown_formatting(md_text: str) -> str:
    if not md_text:
        return ""
    # Remove headers
    text = re.sub(r'^#{1,6}\s+', '', md_text, flags=re.MULTILINE)
    # Remove bold and italic
    text = re.sub(r'\*\*(.*?)\*\*', r'\1', text)
    text = re.sub(r'\*(.*?)\*', r'\1', text)
    text = re.sub(r'__(.*?)__', r'\1', text)
    text = re.sub(r'_(.*?)_', r'\1', text)
    # Remove links
    text = re.sub(r'\[(.*?)\]\(.*?\)', r'\1', text)
    # Remove images
    text = re.sub(r'!\[(.*?)\]\(.*?\)', r'', text)
    # Remove blockquotes
    text = re.sub(r'^>\s+', '', text, flags=re.MULTILINE)
    # Remove code blocks
    text = re.sub(r'```.*?```', '', text, flags=re.DOTALL)
    text = re.sub(r'`(.*?)`', r'\1', text)
    # Remove HTML tags
    text = re.sub(r'<[^>]+>', '', text)
    return text.strip()

def _fmt_info(result: dict) -> str:
    m = result.get("document_metadata", {}) or {}
    authors = m.get("authors", []) or []
    auth_str = ", ".join(authors[:5]) if authors else "—"
    if len(authors) > 5:
        auth_str += f" (+{len(authors) - 5})"

    quality = result.get('quality_score', 0)
    if quality >= 90:
        q_label = f"🟢 Excelente ({quality}/100)"
    elif quality >= 70:
        q_label = f"🟡 Buena ({quality}/100)"
    else:
        q_label = f"🔴 Problemática ({quality}/100)"
        
    ocr = result.get("ocr_stats", {})

    return (
        f"### 📄 Metadata\n\n"
        f"**Título:** {m.get('title') or '—'}\n\n"
        f"**Autores:** {auth_str}\n\n"
        f"**Año:** {m.get('year') or '—'}\n\n"
        f"**DOI:** {m.get('doi') or '—'}\n\n"
        f"---\n\n"
        f"### 📊 Pipeline\n\n"
        f"**Idioma Original:** {result.get('source_language', '?')}\n\n"
        f"**Calidad Global:** {q_label}\n\n"
        f"**Páginas Totales:** {ocr.get('pages_total', '?')}\n\n"
        f"**Páginas OCR (Mistral):** {ocr.get('pages_mistral', 0)}\n\n"
        f"**Costo Estimado OCR:** ${ocr.get('estimated_cost_usd', 0):.4f}\n\n"
        f"**Imágenes Extraídas:** {result.get('images_extracted', 0)}"
    )

def _fmt_details(result: dict) -> str:
    ocr = result.get("ocr_stats", {})
    reasons = ocr.get("reasons", {})
    
    details = "### 🛠️ Detalles Técnicos\n\n"
    if not reasons:
        details += "No se detectaron problemas estructurales que requirieran Mistral OCR.\n"
    else:
        details += "**Intervenciones de OCR por página:**\n\n"
        for pnum, issues in reasons.items():
            details += f"- **Página {pnum}:** {', '.join(issues)}\n"
            
    q_report = result.get("quality_report", {})
    if q_report:
        details += f"\n**Puntuación media del IR:** {q_report.get('average_score', 0):.2f}\n"
        
    return details


async def gradio_url_with_id(url, progress=gr.Progress()):
    if not url or not url.strip():
        return ("Introducí una URL.", "", "", None)
    try:
        progress(0.1, desc="Descargando PDF...")
        # Since process_url is async, we can't easily emit internal progress unless we refactor it.
        # But we can at least show a processing message.
        progress(0.4, desc="Analizando y traduciendo documento (esto puede demorar unos minutos)...")
        r = await process_url(url.strip())
        progress(1.0, desc="¡Completado!")
        return (r["markdown"], _fmt_info(r), _fmt_details(r), r.get("document_id"))
    except Exception as e:
        return ("", f"Error: {e}", "", None)


async def gradio_file_with_id(file, progress=gr.Progress()):
    if file is None:
        return ("Subí un PDF.", "", "", None)
    try:
        progress(0.2, desc="Analizando y traduciendo documento (esto puede demorar unos minutos)...")
        fp = file.name if hasattr(file, "name") else str(file)
        pdf_bytes = Path(fp).read_bytes()
        r = await process_pdf(pdf_bytes)
        progress(1.0, desc="¡Completado!")
        return (r["markdown"], _fmt_info(r), _fmt_details(r), r.get("document_id"))
    except Exception as e:
        return ("", f"Error: {e}", "", None)


with gr.Blocks(title="PsiHub Reader") as demo:
    gr.Markdown("""
# PsiHub Reader v8

Parsing híbrido (**PyMuPDF** + **Mistral OCR 4**) + traducción paralela (**DeepSeek**).
""")

    with gr.Tab("URL"):
        url_in = gr.Textbox(label="URL del PDF", placeholder="https://...")
        btn_url = gr.Button("Traducir PDF", variant="primary")
        
        with gr.Tabs():
            with gr.Tab("📖 Modo Lectura (Renderizado)"):
                out_url = gr.Markdown(
                    label="Traducción",
                    latex_delimiters=[
                        {"left": "$$", "right": "$$", "display": True},
                        {"left": "$", "right": "$", "display": False},
                    ],
                )
            with gr.Tab("📝 Markdown Crudo"):
                out_url_raw = gr.Code(label="Markdown Original", language="markdown")
            with gr.Tab("📄 Texto Plano"):
                out_url_text = gr.Textbox(label="Texto sin formato", lines=20)
            with gr.Tab("🛠️ Detalles"):
                out_url_details = gr.Markdown(label="Detalles de Pipeline")

        info_url = gr.Markdown(label="Información")

        gr.Markdown("### 💾 Descargar")
        with gr.Row():
            dl_url = gr.DownloadButton(
                label="⬇️ Markdown traducido (.md)",
                variant="secondary", visible=False,
            )
            dl_url_orig = gr.DownloadButton(
                label="⬇️ Markdown original (.md)",
                variant="secondary", visible=False,
            )

        async def _wrap_url(url):
            md, info, details, doc_id = await gradio_url_with_id(url)
            if not doc_id:
                return md, md, "", info, details, gr.update(visible=False), gr.update(visible=False)
            md_path = MD_STORE_DIR / f"{doc_id}.md"
            orig_path = MD_STORE_DIR / f"{doc_id}.original.md"
            return (
                md, 
                md,
                strip_markdown_formatting(md),
                info,
                details,
                gr.update(
                    value=str(md_path) if md_path.exists() else None,
                    visible=md_path.exists(),
                ),
                gr.update(
                    value=str(orig_path) if orig_path.exists() else None,
                    visible=orig_path.exists(),
                ),
            )

        btn_url.click(
            _wrap_url, inputs=[url_in],
            outputs=[out_url, out_url_raw, out_url_text, info_url, out_url_details, dl_url, dl_url_orig],
        )

    with gr.Tab("Archivo"):
        f_in = gr.File(label="PDF", file_types=[".pdf"])
        btn_f = gr.Button("Traducir PDF", variant="primary")
        
        with gr.Tabs():
            with gr.Tab("📖 Modo Lectura (Renderizado)"):
                out_f = gr.Markdown(
                    label="Traducción",
                    latex_delimiters=[
                        {"left": "$$", "right": "$$", "display": True},
                        {"left": "$", "right": "$", "display": False},
                    ],
                )
            with gr.Tab("📝 Markdown Crudo"):
                out_f_raw = gr.Code(label="Markdown Original", language="markdown")
            with gr.Tab("📄 Texto Plano"):
                out_f_text = gr.Textbox(label="Texto sin formato", lines=20)
            with gr.Tab("🛠️ Detalles"):
                out_f_details = gr.Markdown(label="Detalles de Pipeline")

        info_f = gr.Markdown(label="Información")

        gr.Markdown("### 💾 Descargar")
        with gr.Row():
            dl_f = gr.DownloadButton(
                label="⬇️ Markdown traducido (.md)",
                variant="secondary", visible=False,
            )
            dl_f_orig = gr.DownloadButton(
                label="⬇️ Markdown original (.md)",
                variant="secondary", visible=False,
            )

        async def _wrap_file(file):
            md, info, details, doc_id = await gradio_file_with_id(file)
            if not doc_id:
                return md, md, "", info, details, gr.update(visible=False), gr.update(visible=False)
            md_path = MD_STORE_DIR / f"{doc_id}.md"
            orig_path = MD_STORE_DIR / f"{doc_id}.original.md"
            return (
                md, 
                md,
                strip_markdown_formatting(md),
                info,
                details,
                gr.update(
                    value=str(md_path) if md_path.exists() else None,
                    visible=md_path.exists(),
                ),
                gr.update(
                    value=str(orig_path) if orig_path.exists() else None,
                    visible=orig_path.exists(),
                ),
            )

        btn_f.click(
            _wrap_file, inputs=[f_in],
            outputs=[out_f, out_f_raw, out_f_text, info_f, out_f_details, dl_f, dl_f_orig],
        )


